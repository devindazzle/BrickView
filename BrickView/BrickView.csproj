<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <ApplicationIcon>BrickView.ico</ApplicationIcon>

    <AssemblyName>BrickView</AssemblyName>
    <RootNamespace>BrickView</RootNamespace>

    <AssemblyTitle>BrickLink Studio .io file browser</AssemblyTitle>

    <Description>BrickLink Studio .io file browser</Description>
    <Company>Kim Pedersen</Company>
    <Product>BrickView</Product>
    <Version>1.1.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
    <Copyright>2026 Kim Pedersen</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\UI\BrickViewFavoriteStates.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="BrickView.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\UI\BrickViewFavoriteStates.png" />
  </ItemGroup>

</Project>