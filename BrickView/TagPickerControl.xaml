<!--
    TagPickerControl.xaml
    
    Provides the compact tag picker used by BrickView model cards.
    
    The control displays existing reusable tags as compact chip-tags in a
    wrapping layout and provides an option to create a new tag directly from
    the picker.
    
    Tag colors are taken directly from TagDefinition so every tag has the
    same appearance in the picker and on model cards.
-->

<UserControl
    x:Class="BrickView.TagPickerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <UserControl.Resources>

        <SolidColorBrush x:Key="TagPickerPrimaryTextBrush" Color="#F3F3F3" />

        <Style x:Key="CreateTagButtonStyle" TargetType="Button">

            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource TagPickerPrimaryTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="CreateBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="CreateBorder" Property="Background" Value="#394D5F" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </UserControl.Resources>

    <Popup
        x:Name="TagPickerPopup"
        AllowsTransparency="True"
        Placement="Bottom"
        StaysOpen="False"
        VerticalOffset="4">

        <Border
            Width="230"
            Padding="8"
            Background="#2A2D34"
            BorderBrush="#4A4D52"
            BorderThickness="1"
            CornerRadius="5">

            <StackPanel>

                <Grid Height="30">

                    <TextBox
                        x:Name="SearchTextBox"
                        Height="30"
                        Padding="10,0"
                        VerticalContentAlignment="Center"
                        Background="#18191D"
                        BorderBrush="#4A4D52"
                        BorderThickness="1"
                        FontSize="12"
                        Foreground="{StaticResource TagPickerPrimaryTextBrush}"
                        TextChanged="SearchTextBox_TextChanged" />

                    <TextBlock
                        Margin="10,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="#77777A"
                        IsHitTestVisible="False"
                        Text="Søg eller vælg tag...">

                        <TextBlock.Style>

                            <Style TargetType="TextBlock">

                                <Setter Property="Visibility" Value="Collapsed" />

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">

                                        <Setter Property="Visibility" Value="Visible" />

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>

                        </TextBlock.Style>

                    </TextBlock>

                </Grid>

                <ScrollViewer
                    MaxHeight="180"
                    Margin="0,6,0,0"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">

                    <ItemsControl x:Name="TagItemsControl" HorizontalAlignment="Left">

                        <ItemsControl.ItemsPanel>

                            <ItemsPanelTemplate>

                                <WrapPanel />

                            </ItemsPanelTemplate>

                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Border
                                    Margin="0,0,4,4"
                                    Background="{Binding BackgroundColor}"
                                    BorderBrush="{Binding BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="8">

                                    <Grid Height="16">

                                        <Grid.ColumnDefinitions>

                                            <ColumnDefinition Width="Auto" />

                                            <ColumnDefinition Width="Auto" />

                                        </Grid.ColumnDefinitions>

                                        <Button
                                            Grid.Column="0"
                                            Padding="6,0,2,0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="TagChip_Click"
                                            Content="{Binding Name}"
                                            Cursor="Hand"
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TagPickerPrimaryTextBrush}" />

                                        <Button
                                            Grid.Column="1"
                                            Width="16"
                                            Padding="0"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Click="DeleteTagButton_Click"
                                            Content="×"
                                            Cursor="Hand"
                                            FontSize="10"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource TagPickerPrimaryTextBrush}"
                                            ToolTip="Delete tag" />

                                    </Grid>

                                </Border>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </ScrollViewer>

                <Border
                    x:Name="CreateTagSeparator"
                    Height="1"
                    Margin="0,2,0,2"
                    Background="#4A4D52"
                    Visibility="Collapsed" />

                <Button
                    x:Name="CreateTagButton"
                    Click="CreateTagButton_Click"
                    Style="{StaticResource CreateTagButtonStyle}"
                    Visibility="Collapsed">

                    <TextBlock x:Name="CreateTagText" Text="+ Create tag" />

                </Button>

            </StackPanel>

        </Border>

    </Popup>

</UserControl>