<Window
    x:Class="BrickView.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:BrickView"
    Title="BrickView"
    Width="1100"
    Height="750"
    MinWidth="800"
    MinHeight="550"
    Background="#202124"
    Foreground="#F1F3F4"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">

    <Window.Resources>

        <!--  Application colours  -->

        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202124" />

        <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#292A2D" />

        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#2B2D30" />

        <SolidColorBrush x:Key="CardBorderBrush" Color="#44474B" />

        <SolidColorBrush x:Key="CardHoverBrush" Color="#34373B" />

        <SolidColorBrush x:Key="CardSelectedBrush" Color="#394D5F" />

        <SolidColorBrush x:Key="ThumbnailBackgroundBrush" Color="#18191B" />

        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F1F3F4" />

        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A8ABB0" />

        <SolidColorBrush x:Key="ErrorTextBrush" Color="#FF7B7B" />

        <SolidColorBrush x:Key="AccentBrush" Color="#4EA3FF" />

        <!--  Button style  -->

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="#34363A" />

            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />

            <Setter Property="BorderBrush" Value="#4A4D52" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="Padding" Value="16,8" />

            <Setter Property="FontSize" Value="13" />

            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="ButtonBorder" Property="Background" Value="#414449" />

                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#5D6167" />

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2D2F32" />

                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">

                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!--  ListBoxItem style  -->

        <Style x:Key="MocListBoxItemStyle" TargetType="ListBoxItem">

            <Setter Property="Padding" Value="0" />

            <Setter Property="Margin" Value="0" />

            <Setter Property="Background" Value="Transparent" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="HorizontalContentAlignment" Value="Left" />

            <Setter Property="VerticalContentAlignment" Value="Top" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ListBoxItem">

                        <Border
                            x:Name="ItemBorder"
                            Padding="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="5"
                            SnapsToDevicePixels="True">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource CardHoverBrush}" />

                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#555A60" />

                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">

                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource CardSelectedBrush}" />

                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource WindowBackgroundBrush}">

        <Grid.RowDefinitions>

            <RowDefinition Height="58" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />

        </Grid.RowDefinitions>

        <!--  Top toolbar  -->

        <Border
            Grid.Row="0"
            Background="{StaticResource ToolbarBackgroundBrush}"
            BorderBrush="#37393D"
            BorderThickness="0,0,0,1">

            <Grid Margin="16,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto" />

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="Auto" />

                </Grid.ColumnDefinitions>

                <!--  Application name  -->

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    Text="BrickView" />

                <!--  Current folder  -->

                <TextBlock
                    Grid.Column="1"
                    Margin="24,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    Text="{Binding ElementName=FolderText, Path=Text}"
                    TextTrimming="CharacterEllipsis" />

                <!--  Toolbar buttons  -->

                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <Button
                        x:Name="SelectFolderButton"
                        Height="34"
                        Margin="0,0,8,0"
                        Click="SelectFolder_Click"
                        Content="Select folder"
                        Style="{StaticResource ToolbarButtonStyle}" />

                    <Button
                        x:Name="RefreshViewButton"
                        Height="34"
                        Click="RefreshView_Click"
                        Content="↻  Refresh"
                        Style="{StaticResource ToolbarButtonStyle}" />

                </StackPanel>

            </Grid>

        </Border>

        <!--  Folder information  -->

        <Border
            Grid.Row="1"
            Padding="16,10"
            Background="#242629"
            BorderBrush="#34363A"
            BorderThickness="0,0,0,1">

            <TextBlock
                x:Name="FolderText"
                FontSize="12"
                Foreground="{StaticResource SecondaryTextBrush}"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

        </Border>

        <!--  MOC thumbnail grid  -->

        <ListBox
            x:Name="FileList"
            Grid.Row="2"
            HorizontalContentAlignment="Stretch"
            Background="Transparent"
            BorderThickness="0"
            ItemContainerStyle="{StaticResource MocListBoxItemStyle}"
            MouseDoubleClick="FileList_MouseDoubleClick"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto">

            <!--  Virtualized grid  -->

            <ListBox.ItemsPanel>

                <ItemsPanelTemplate>

                    <local:VirtualizingWrapPanel />

                </ItemsPanelTemplate>

            </ListBox.ItemsPanel>

            <!--  MOC card  -->

            <ListBox.ItemTemplate>

                <DataTemplate>

                    <StackPanel
                        Width="180"
                        Height="270"
                        Margin="10">

                        <!--  Thumbnail  -->

                        <Border
                            Width="180"
                            Height="180"
                            Background="{StaticResource ThumbnailBackgroundBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">

                            <Grid>

                                <!--  Thumbnail image  -->

                                <Image
                                    Margin="5"
                                    Source="{Binding Thumbnail}"
                                    Stretch="Uniform">

                                    <Image.Style>

                                        <Style TargetType="Image">

                                            <Setter Property="Visibility" Value="Collapsed" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsThumbnailLoaded}" Value="True">

                                                    <Setter Property="Visibility" Value="Visible" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Image.Style>

                                </Image>

                                <!--  Loading  -->

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="Loading...">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Visibility" Value="Collapsed" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsThumbnailLoading}" Value="True">

                                                    <Setter Property="Visibility" Value="Visible" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                                <!--  Not loaded  -->

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="Not loaded">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Visibility" Value="Collapsed" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsThumbnailNotLoaded}" Value="True">

                                                    <Setter Property="Visibility" Value="Visible" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                                <!--  No thumbnail  -->

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="No thumbnail">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Visibility" Value="Collapsed" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsThumbnailMissing}" Value="True">

                                                    <Setter Property="Visibility" Value="Visible" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                                <!--  Invalid file  -->

                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource ErrorTextBrush}"
                                    Text="⚠ Invalid file">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Visibility" Value="Collapsed" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsThumbnailError}" Value="True">

                                                    <Setter Property="Visibility" Value="Visible" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                            </Grid>

                        </Border>

                        <!--  File name  -->

                        <TextBlock
                            Margin="2,8,2,0"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Text="{Binding FileName}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding FilePath}" />

                        <!--  Error message  -->

                        <TextBlock
                            Margin="2,3,2,0"
                            FontSize="11"
                            Foreground="{StaticResource ErrorTextBrush}"
                            Text="{Binding ErrorMessage}"
                            TextWrapping="Wrap" />

                    </StackPanel>

                </DataTemplate>

            </ListBox.ItemTemplate>

        </ListBox>

    </Grid>

</Window>