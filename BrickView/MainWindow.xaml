<Window
    x:Class="BrickView.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:BrickView"
    Title="BrickView"
    Width="1100"
    Height="750"
    MinWidth="800"
    MinHeight="550"
    Background="#24252E"
    Foreground="#F3F3F3"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">

    <Window.Resources>

        <!--  =====================================================  -->
        <!--  Studio-inspired colour palette  -->
        <!--  =====================================================  -->

        <SolidColorBrush x:Key="OuterBackgroundBrush" Color="#24252E" />

        <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#24252E" />

        <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#2A2D34" />

        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#24252E" />

        <SolidColorBrush x:Key="CardBorderBrush" Color="#303138" />

        <SolidColorBrush x:Key="CardSelectedBrush" Color="#394D5F" />

        <SolidColorBrush x:Key="ThumbnailBackgroundBrush" Color="#18191D" />

        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F3F3F3" />

        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#77777A" />

        <SolidColorBrush x:Key="ErrorTextBrush" Color="#FF7B7B" />

        <SolidColorBrush x:Key="AccentBrush" Color="#4EA3FF" />

        <SolidColorBrush x:Key="ThumbnailOverlayBrush" Color="#B5000000" />

        <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#303138" />

        <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#50515A" />

        <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#65666F" />

        <!--  =====================================================  -->
        <!--  Toolbar button  -->
        <!--  =====================================================  -->

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="#34363A" />

            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />

            <Setter Property="BorderBrush" Value="#4A4D52" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="Padding" Value="16,8" />

            <Setter Property="FontSize" Value="13" />

            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="ButtonBorder" Property="Background" Value="#414449" />

                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#5D6167" />

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2D2F32" />

                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">

                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!--  =====================================================  -->
        <!--  Search box  -->
        <!--  =====================================================  -->

        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">

            <Setter Property="Height" Value="30" />

            <Setter Property="Background" Value="#18191D" />

            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />

            <Setter Property="BorderBrush" Value="#303138" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter Property="Padding" Value="12,0" />

            <Setter Property="FontSize" Value="13" />

            <Setter Property="VerticalContentAlignment" Value="Center" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border
                            x:Name="SearchBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="15"
                            SnapsToDevicePixels="True">

                            <Grid>

                                <ScrollViewer
                                    x:Name="PART_ContentHost"
                                    Margin="12,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    x:Name="SearchPlaceholder"
                                    Margin="14,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    IsHitTestVisible="False"
                                    Text="Search models..."
                                    Visibility="Collapsed" />

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="Text" Value="">

                                <Setter TargetName="SearchPlaceholder" Property="Visibility" Value="Visible" />

                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin" Value="True">

                                <Setter TargetName="SearchPlaceholder" Property="Visibility" Value="Collapsed" />

                                <Setter TargetName="SearchBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!--  =====================================================  -->
        <!--  ListBox item  -->
        <!--  =====================================================  -->

        <Style x:Key="MocListBoxItemStyle" TargetType="ListBoxItem">

            <Setter Property="Padding" Value="0" />

            <Setter Property="Margin" Value="0" />

            <Setter Property="Background" Value="Transparent" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="HorizontalContentAlignment" Value="Center" />

            <Setter Property="VerticalContentAlignment" Value="Center" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ListBoxItem">

                        <Grid>

                            <Border
                                x:Name="ItemBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True" />

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />

                            <Border
                                x:Name="SelectionBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="5"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True" />

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsSelected" Value="True">

                                <Setter TargetName="ItemBackground" Property="Background" Value="{StaticResource CardSelectedBrush}" />

                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <!--  =====================================================  -->
        <!--  Studio-inspired ScrollBar  -->
        <!--  =====================================================  -->

        <Style TargetType="ScrollBar">

            <Setter Property="Width" Value="12" />

            <Setter Property="Background" Value="{StaticResource ScrollBarTrackBrush}" />

            <Setter Property="Foreground" Value="{StaticResource ScrollBarThumbBrush}" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ScrollBar">

                        <Grid Background="{TemplateBinding Background}">

                            <Track
                                x:Name="PART_Track"
                                IsDirectionReversed="True"
                                Orientation="{TemplateBinding Orientation}">

                                <Track.Thumb>

                                    <Thumb>

                                        <Thumb.Style>

                                            <Style TargetType="Thumb">

                                                <Setter Property="Background" Value="{StaticResource ScrollBarThumbBrush}" />

                                                <Setter Property="BorderThickness" Value="0" />

                                                <Setter Property="Margin" Value="2,3" />

                                                <Setter Property="Template">

                                                    <Setter.Value>

                                                        <ControlTemplate TargetType="Thumb">

                                                            <Border
                                                                x:Name="ThumbBorder"
                                                                Background="{TemplateBinding Background}"
                                                                CornerRadius="4" />

                                                            <ControlTemplate.Triggers>

                                                                <Trigger Property="IsMouseOver" Value="True">

                                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource ScrollBarThumbHoverBrush}" />

                                                                </Trigger>

                                                            </ControlTemplate.Triggers>

                                                        </ControlTemplate>

                                                    </Setter.Value>

                                                </Setter>

                                            </Style>

                                        </Thumb.Style>

                                    </Thumb>

                                </Track.Thumb>

                                <Track.DecreaseRepeatButton>

                                    <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Opacity="0" />

                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>

                                    <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}" Opacity="0" />

                                </Track.IncreaseRepeatButton>

                            </Track>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="Orientation" Value="Horizontal">

                    <Setter Property="Height" Value="12" />

                    <Setter Property="Width" Value="Auto" />

                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource OuterBackgroundBrush}">

        <Grid.RowDefinitions>

            <RowDefinition Height="58" />

            <RowDefinition Height="Auto" />

            <RowDefinition Height="*" />

        </Grid.RowDefinitions>

        <!--  =====================================================  -->
        <!--  Top toolbar  -->
        <!--  =====================================================  -->

        <Border
            Grid.Row="0"
            Background="{StaticResource ToolbarBackgroundBrush}"
            BorderBrush="#34363C"
            BorderThickness="0,0,0,1">

            <Grid Margin="16,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto" />

                    <ColumnDefinition Width="*" />

                    <ColumnDefinition Width="Auto" />

                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    Text="BrickView" />

                <!--  Current folder  -->

                <TextBlock
                    x:Name="FolderText"
                    Grid.Column="1"
                    Margin="24,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <Button
                        x:Name="SelectFolderButton"
                        Height="34"
                        Margin="0,0,8,0"
                        Click="SelectFolder_Click"
                        Content="Select folder"
                        Style="{StaticResource ToolbarButtonStyle}" />

                    <Button
                        x:Name="RefreshViewButton"
                        Height="34"
                        Click="RefreshView_Click"
                        Content="↻  Refresh"
                        Style="{StaticResource ToolbarButtonStyle}" />

                </StackPanel>

            </Grid>

        </Border>

        <!--  =====================================================  -->
        <!--  Search / future secondary toolbar  -->
        <!--  =====================================================  -->

        <Border
            Grid.Row="1"
            Padding="9"
            Background="{StaticResource OuterBackgroundBrush}"
            BorderBrush="#34363C"
            BorderThickness="0,0,0,1">

            <TextBox
                x:Name="SearchTextBox"
                Width="360"
                HorizontalAlignment="Left"
                Style="{StaticResource SearchTextBoxStyle}" />

        </Border>

        <!--  =====================================================  -->
        <!--  Thumbnail area  -->
        <!--  =====================================================  -->

        <Border Grid.Row="2" Background="{StaticResource ContentBackgroundBrush}">

            <Grid>

                <ListBox
                    x:Name="FileList"
                    Padding="9"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource MocListBoxItemStyle}"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListBox.ItemsPanel>

                        <ItemsPanelTemplate>

                            <local:VirtualizingWrapPanel />

                        </ItemsPanelTemplate>

                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <StackPanel
                                Width="360"
                                Height="290"
                                Margin="0">

                                <!--  Thumbnail  -->

                                <Border
                                    x:Name="ThumbnailBorder"
                                    Width="360"
                                    Height="240"
                                    Background="{StaticResource ThumbnailBackgroundBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="Thumbnail_MouseLeftButtonUp"
                                    SnapsToDevicePixels="True">

                                    <Grid ClipToBounds="True">

                                        <Image
                                            Margin="5"
                                            Source="{Binding Thumbnail}"
                                            Stretch="Uniform">

                                            <Image.Style>

                                                <Style TargetType="Image">

                                                    <Setter Property="Visibility" Value="Collapsed" />

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding IsThumbnailLoaded}" Value="True">

                                                            <Setter Property="Visibility" Value="Visible" />

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </Image.Style>

                                        </Image>

                                        <!--  Loading  -->

                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            Text="Loading...">

                                            <TextBlock.Style>

                                                <Style TargetType="TextBlock">

                                                    <Setter Property="Visibility" Value="Collapsed" />

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding IsThumbnailLoading}" Value="True">

                                                            <Setter Property="Visibility" Value="Visible" />

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </TextBlock.Style>

                                        </TextBlock>

                                        <!--  Not loaded  -->

                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            Text="Not loaded">

                                            <TextBlock.Style>

                                                <Style TargetType="TextBlock">

                                                    <Setter Property="Visibility" Value="Collapsed" />

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding IsThumbnailNotLoaded}" Value="True">

                                                            <Setter Property="Visibility" Value="Visible" />

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </TextBlock.Style>

                                        </TextBlock>

                                        <!--  No thumbnail  -->

                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            Text="No thumbnail">

                                            <TextBlock.Style>

                                                <Style TargetType="TextBlock">

                                                    <Setter Property="Visibility" Value="Collapsed" />

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding IsThumbnailMissing}" Value="True">

                                                            <Setter Property="Visibility" Value="Visible" />

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </TextBlock.Style>

                                        </TextBlock>

                                        <!--  Invalid file  -->

                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource ErrorTextBrush}"
                                            Text="⚠ Invalid file">

                                            <TextBlock.Style>

                                                <Style TargetType="TextBlock">

                                                    <Setter Property="Visibility" Value="Collapsed" />

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding IsThumbnailError}" Value="True">

                                                            <Setter Property="Visibility" Value="Visible" />

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </TextBlock.Style>

                                        </TextBlock>

                                        <!--  Hover overlay  -->

                                        <Border Background="{StaticResource ThumbnailOverlayBrush}" IsHitTestVisible="False">

                                            <Border.Style>

                                                <Style TargetType="Border">

                                                    <Setter Property="Visibility" Value="Collapsed" />

                                                    <Setter Property="Opacity" Value="0" />

                                                    <Style.Triggers>

                                                        <MultiDataTrigger>

                                                            <MultiDataTrigger.Conditions>

                                                                <Condition Binding="{Binding IsThumbnailLoaded}" Value="True" />

                                                                <Condition Binding="{Binding IsMouseOver, ElementName=ThumbnailBorder}" Value="True" />

                                                            </MultiDataTrigger.Conditions>

                                                            <Setter Property="Visibility" Value="Visible" />

                                                            <Setter Property="Opacity" Value="1" />

                                                        </MultiDataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </Border.Style>

                                            <Grid>

                                                <Border
                                                    Width="114"
                                                    Height="38"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="#3D3F45"
                                                    BorderBrush="#77777A"
                                                    BorderThickness="1"
                                                    CornerRadius="4">

                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        Foreground="#FFFFFF"
                                                        Text="Open file" />

                                                </Border>

                                            </Grid>

                                        </Border>

                                    </Grid>

                                </Border>

                                <!--  File name  -->

                                <TextBlock
                                    Margin="2,8,2,0"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryTextBrush}"
                                    Text="{Binding FileName, StringFormat={}{0}.io}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding FilePath}" />

                                <!--  Parts count  -->

                                <TextBlock
                                    Margin="2,3,2,0"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="" />

                                <!--  Error message  -->

                                <TextBlock
                                    Margin="2,3,2,0"
                                    FontSize="11"
                                    Foreground="{StaticResource ErrorTextBrush}"
                                    Text="{Binding ErrorMessage}"
                                    TextWrapping="Wrap" />

                            </StackPanel>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

                <TextBlock
                    x:Name="NoResultsText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    IsHitTestVisible="False"
                    Text="No models found"
                    Visibility="Collapsed" />

                <TextBlock
                    x:Name="NoFolderSelectedText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    IsHitTestVisible="False"
                    Text="No folder selected"
                    Visibility="Visible" />

            </Grid>

        </Border>

    </Grid>

</Window>