<Window
    x:Class="BrickView.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:BrickView"
    Title="BrickView"
    Width="1000"
    Height="700">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Select folder and refresh buttons  -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">

            <Button
                x:Name="SelectFolderButton"
                Width="120"
                Height="35"
                Click="SelectFolder_Click"
                Content="Select folder" />

            <Button
                x:Name="RefreshViewButton"
                Width="120"
                Height="35"
                Margin="10,0,0,0"
                Click="RefreshView_Click"
                Content="Refresh View" />

        </StackPanel>

        <!--  Selected folder  -->
        <TextBlock
            x:Name="FolderText"
            Grid.Row="1"
            Margin="0,15,0,15"
            FontSize="14" />

        <!--  MOC thumbnail grid  -->
        <ListBox
            x:Name="FileList"
            Grid.Row="2"
            HorizontalContentAlignment="Stretch"
            MouseDoubleClick="FileList_MouseDoubleClick"
            ScrollViewer.CanContentScroll="True"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.VerticalScrollBarVisibility="Auto">

            <ListBox.ItemsPanel>

                <ItemsPanelTemplate>

                    <local:VirtualizingWrapPanel />

                </ItemsPanelTemplate>

            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>

                <DataTemplate>

                    <StackPanel
                        Width="180"
                        Height="270"
                        Margin="10">

                        <!--  Thumbnail area  -->
                        <Border
                            Width="180"
                            Height="180"
                            BorderBrush="LightGray"
                            BorderThickness="1">

                            <Grid>

                                <!--  Actual thumbnail  -->
                                <Image
                                    Margin="5"
                                    Source="{Binding Thumbnail}"
                                    Stretch="Uniform">

                                    <Image.Style>

                                        <Style TargetType="Image">

                                            <Setter Property="Visibility" Value="Collapsed" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsThumbnailLoaded}" Value="True">

                                                    <Setter Property="Visibility" Value="Visible" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </Image.Style>

                                </Image>

                                <!--  Loading  -->
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="Gray"
                                    Text="Loading...">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Visibility" Value="Collapsed" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsThumbnailLoading}" Value="True">

                                                    <Setter Property="Visibility" Value="Visible" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                                <!--  Not loaded  -->
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="Gray"
                                    Text="Not loaded">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Visibility" Value="Collapsed" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsThumbnailNotLoaded}" Value="True">

                                                    <Setter Property="Visibility" Value="Visible" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                                <!--  No thumbnail  -->
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="Gray"
                                    Text="No thumbnail">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Visibility" Value="Collapsed" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsThumbnailMissing}" Value="True">

                                                    <Setter Property="Visibility" Value="Visible" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                                <!--  Invalid file  -->
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="Bold"
                                    Foreground="DarkRed"
                                    Text="⚠ Invalid file">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Visibility" Value="Collapsed" />

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding IsThumbnailError}" Value="True">

                                                    <Setter Property="Visibility" Value="Visible" />

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                            </Grid>

                        </Border>

                        <!--  File name  -->
                        <TextBlock
                            Margin="0,5,0,0"
                            FontWeight="Bold"
                            Text="{Binding FileName}"
                            TextWrapping="Wrap"
                            ToolTip="{Binding FilePath}" />

                        <!--  Error message  -->
                        <TextBlock
                            Foreground="DarkRed"
                            Text="{Binding ErrorMessage}"
                            TextWrapping="Wrap" />

                    </StackPanel>

                </DataTemplate>

            </ListBox.ItemTemplate>

        </ListBox>

    </Grid>

</Window>