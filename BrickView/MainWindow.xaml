<Window
    x:Class="BrickView.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:BrickView"
    Title="BrickView"
    Width="1100"
    Height="750"
    MinWidth="800"
    MinHeight="550"
    Background="#24252E"
    Foreground="#F3F3F3"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">

    <Window.Resources>

        <SolidColorBrush x:Key="OuterBackgroundBrush" Color="#24252E" />
        <SolidColorBrush x:Key="ContentBackgroundBrush" Color="#24252E" />
        <SolidColorBrush x:Key="ToolbarBackgroundBrush" Color="#2A2D34" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#24252E" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#303138" />
        <SolidColorBrush x:Key="CardSelectedBrush" Color="#394D5F" />
        <SolidColorBrush x:Key="ThumbnailBackgroundBrush" Color="#18191D" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F3F3F3" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#77777A" />
        <SolidColorBrush x:Key="ErrorTextBrush" Color="#FF7B7B" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4EA3FF" />
        <SolidColorBrush x:Key="ThumbnailOverlayBrush" Color="#B5000000" />
        <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#303138" />
        <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#50515A" />
        <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#65666F" />

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="#34363A" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="#4A4D52" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="ButtonBorder" Property="Background" Value="#414449" />

                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#5D6167" />

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2D2F32" />

                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">

                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.5" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">

            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="#18191D" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="#303138" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="TextBox">

                        <Border
                            x:Name="SearchBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="15"
                            SnapsToDevicePixels="True">

                            <Grid>

                                <ScrollViewer
                                    x:Name="PART_ContentHost"
                                    Margin="12,0"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    x:Name="SearchPlaceholder"
                                    Margin="14,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    IsHitTestVisible="False"
                                    Text="Search models..."
                                    Visibility="Collapsed" />

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="Text" Value="">

                                <Setter TargetName="SearchPlaceholder" Property="Visibility" Value="Visible" />

                            </Trigger>

                            <Trigger Property="IsKeyboardFocusWithin" Value="True">

                                <Setter TargetName="SearchPlaceholder" Property="Visibility" Value="Collapsed" />

                                <Setter TargetName="SearchBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="ThumbnailSizeSelectorStyle" TargetType="RadioButton">

            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#4A4D52" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="RadioButton">

                        <Border
                            x:Name="SelectorBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="SelectorBorder" Property="Background" Value="#414449" />

                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />

                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">

                                <Setter TargetName="SelectorBorder" Property="Background" Value="{StaticResource CardSelectedBrush}" />

                                <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />

                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">

                                <Setter TargetName="SelectorBorder" Property="Opacity" Value="0.5" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style
            x:Key="ThumbnailSizeSelectorLastStyle"
            BasedOn="{StaticResource ThumbnailSizeSelectorStyle}"
            TargetType="RadioButton">

            <Setter Property="BorderThickness" Value="0" />

        </Style>

        <Style x:Key="SortButtonStyle" TargetType="ToggleButton">

            <Setter Property="Height" Value="30" />
            <Setter Property="Width" Value="178" />
            <Setter Property="Background" Value="#34363A" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="#4A4D52" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ToggleButton">

                        <Border
                            x:Name="SortButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />

                                </Grid.ColumnDefinitions>

                                <ContentPresenter
                                    Grid.Column="0"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />

                                <TextBlock
                                    Grid.Column="1"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="⌄" />

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="SortButtonBorder" Property="Background" Value="#414449" />

                                <Setter TargetName="SortButtonBorder" Property="BorderBrush" Value="#5D6167" />

                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">

                                <Setter TargetName="SortButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />

                                <Setter TargetName="SortButtonBorder" Property="Background" Value="#394D5F" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="SortPopupOptionStyle" TargetType="Button">

            <Setter Property="Height" Value="36" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border
                            x:Name="OptionBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="OptionBorder" Property="Background" Value="#394D5F" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style x:Key="MocListBoxItemStyle" TargetType="ListBoxItem">

            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ListBoxItem">

                        <Grid>

                            <Border
                                x:Name="ItemBackground"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True" />

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding Content}"
                                ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />

                            <Border
                                x:Name="SelectionBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="5"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True" />

                        </Grid>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsSelected" Value="True">

                                <Setter TargetName="ItemBackground" Property="Background" Value="{StaticResource CardSelectedBrush}" />

                                <Setter TargetName="SelectionBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

        <Style TargetType="ScrollBar">

            <Setter Property="Width" Value="12" />
            <Setter Property="Background" Value="{StaticResource ScrollBarTrackBrush}" />
            <Setter Property="Foreground" Value="{StaticResource ScrollBarThumbBrush}" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="ScrollBar">

                        <Grid Background="{TemplateBinding Background}">

                            <Track
                                x:Name="PART_Track"
                                IsDirectionReversed="True"
                                Orientation="{TemplateBinding Orientation}">

                                <Track.Thumb>

                                    <Thumb>

                                        <Thumb.Style>

                                            <Style TargetType="Thumb">

                                                <Setter Property="Background" Value="{StaticResource ScrollBarThumbBrush}" />

                                                <Setter Property="BorderThickness" Value="0" />

                                                <Setter Property="Margin" Value="2,3" />

                                                <Setter Property="Template">

                                                    <Setter.Value>

                                                        <ControlTemplate TargetType="Thumb">

                                                            <Border
                                                                x:Name="ThumbBorder"
                                                                Background="{TemplateBinding Background}"
                                                                CornerRadius="4" />

                                                            <ControlTemplate.Triggers>

                                                                <Trigger Property="IsMouseOver" Value="True">

                                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource ScrollBarThumbHoverBrush}" />

                                                                </Trigger>

                                                            </ControlTemplate.Triggers>

                                                        </ControlTemplate>

                                                    </Setter.Value>

                                                </Setter>

                                            </Style>

                                        </Thumb.Style>

                                    </Thumb>

                                </Track.Thumb>

                                <Track.DecreaseRepeatButton>

                                    <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Opacity="0" />

                                </Track.DecreaseRepeatButton>

                                <Track.IncreaseRepeatButton>

                                    <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}" Opacity="0" />

                                </Track.IncreaseRepeatButton>

                            </Track>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

            <Style.Triggers>

                <Trigger Property="Orientation" Value="Horizontal">

                    <Setter Property="Height" Value="12" />
                    <Setter Property="Width" Value="Auto" />

                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource OuterBackgroundBrush}">

        <Grid.RowDefinitions>

            <RowDefinition Height="58" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />

        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="{StaticResource ToolbarBackgroundBrush}"
            BorderBrush="#34363C"
            BorderThickness="0,0,0,1">

            <Grid Margin="16,0">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />

                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="{StaticResource PrimaryTextBrush}"
                    Text="BrickView" />

                <TextBlock
                    x:Name="FolderText"
                    Grid.Column="1"
                    Margin="24,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">

                    <Button
                        x:Name="SelectFolderButton"
                        Height="34"
                        Margin="0,0,8,0"
                        Click="SelectFolder_Click"
                        Content="Select folder"
                        Style="{StaticResource ToolbarButtonStyle}" />

                    <Button
                        x:Name="RefreshViewButton"
                        Height="34"
                        Click="RefreshView_Click"
                        Content="↻  Refresh"
                        Style="{StaticResource ToolbarButtonStyle}" />

                </StackPanel>

            </Grid>

        </Border>

        <Border
            Grid.Row="1"
            Padding="9"
            Background="{StaticResource OuterBackgroundBrush}"
            BorderBrush="#34363C"
            BorderThickness="0,0,0,1">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />

                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="SearchTextBox"
                    Width="360"
                    HorizontalAlignment="Left"
                    Style="{StaticResource SearchTextBoxStyle}" />

                <ToggleButton
                    x:Name="SortButton"
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    IsChecked="{Binding IsOpen, ElementName=SortPopup, Mode=TwoWay}"
                    Style="{StaticResource SortButtonStyle}">

                    <Grid>

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />

                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Text="Aa" />

                        <TextBlock
                            x:Name="SortButtonContent"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            Text="File name" />

                        <TextBlock
                            x:Name="SortDirectionText"
                            Grid.Column="2"
                            Margin="5,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{StaticResource AccentBrush}"
                            Text="↑" />

                    </Grid>

                </ToggleButton>

                <Popup
                    x:Name="SortPopup"
                    AllowsTransparency="True"
                    Placement="Bottom"
                    PlacementTarget="{Binding ElementName=SortButton}"
                    StaysOpen="False">

                    <Border
                        Width="235"
                        Margin="0,5,0,0"
                        Padding="8"
                        Background="#2A2D34"
                        BorderBrush="#4A4D52"
                        BorderThickness="1"
                        CornerRadius="5">

                        <StackPanel>

                            <TextBlock
                                Margin="8,4,8,6"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="SORT BY" />

                            <Button Click="SortFileName_Click" Style="{StaticResource SortPopupOptionStyle}">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />

                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{StaticResource PrimaryTextBrush}"
                                        Text="Aa" />

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="File name" />

                                    <TextBlock
                                        x:Name="FileNameSortCheck"
                                        Grid.Column="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{StaticResource AccentBrush}"
                                        Text="✓" />

                                </Grid>

                            </Button>

                            <Button Click="SortCreatedDate_Click" Style="{StaticResource SortPopupOptionStyle}">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />

                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{StaticResource PrimaryTextBrush}"
                                        Text="▣" />

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="Created date" />

                                    <TextBlock
                                        x:Name="CreatedDateSortCheck"
                                        Grid.Column="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{StaticResource AccentBrush}"
                                        Text="✓"
                                        Visibility="Collapsed" />

                                </Grid>

                            </Button>

                            <Button Click="SortModifiedDate_Click" Style="{StaticResource SortPopupOptionStyle}">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />

                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{StaticResource PrimaryTextBrush}"
                                        Text="◷" />

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="Modified date" />

                                    <TextBlock
                                        x:Name="ModifiedDateSortCheck"
                                        Grid.Column="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{StaticResource AccentBrush}"
                                        Text="✓"
                                        Visibility="Collapsed" />

                                </Grid>

                            </Button>

                            <Border
                                Height="1"
                                Margin="6,6"
                                Background="#4A4D52" />

                            <TextBlock
                                Margin="8,0,8,6"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource SecondaryTextBrush}"
                                Text="ORDER" />

                            <Button Click="SortAscending_Click" Style="{StaticResource SortPopupOptionStyle}">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />

                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        Foreground="{StaticResource PrimaryTextBrush}"
                                        Text="↑" />

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="Ascending" />

                                    <TextBlock
                                        x:Name="AscendingSortCheck"
                                        Grid.Column="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{StaticResource AccentBrush}"
                                        Text="✓" />

                                </Grid>

                            </Button>

                            <Button Click="SortDescending_Click" Style="{StaticResource SortPopupOptionStyle}">

                                <Grid>

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />

                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        Foreground="{StaticResource PrimaryTextBrush}"
                                        Text="↓" />

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="Descending" />

                                    <TextBlock
                                        x:Name="DescendingSortCheck"
                                        Grid.Column="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{StaticResource AccentBrush}"
                                        Text="✓"
                                        Visibility="Collapsed" />

                                </Grid>

                            </Button>

                        </StackPanel>

                    </Border>

                </Popup>

                <Border
                    Grid.Column="2"
                    Height="30"
                    Padding="1"
                    VerticalAlignment="Center"
                    Background="#34363A"
                    BorderBrush="#4A4D52"
                    BorderThickness="1"
                    ClipToBounds="True"
                    CornerRadius="4">

                    <StackPanel Orientation="Horizontal">

                        <RadioButton
                            x:Name="SmallThumbnailSizeRadioButton"
                            Width="68"
                            Checked="ThumbnailSizeSelector_Checked"
                            GroupName="ThumbnailSize"
                            Style="{StaticResource ThumbnailSizeSelectorStyle}"
                            Tag="Small"
                            ToolTip="Small">

                            <Path
                                Width="8"
                                Height="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M 0,0 H 1 V 1 H 0 Z"
                                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"
                                Stretch="Fill" />

                        </RadioButton>

                        <RadioButton
                            x:Name="MediumThumbnailSizeRadioButton"
                            Width="78"
                            Checked="ThumbnailSizeSelector_Checked"
                            GroupName="ThumbnailSize"
                            Style="{StaticResource ThumbnailSizeSelectorStyle}"
                            Tag="Medium"
                            ToolTip="Medium">

                            <Path
                                Width="12"
                                Height="12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M 0,0 H 1 V 1 H 0 Z"
                                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"
                                Stretch="Fill" />

                        </RadioButton>

                        <RadioButton
                            x:Name="LargeThumbnailSizeRadioButton"
                            Width="68"
                            Checked="ThumbnailSizeSelector_Checked"
                            GroupName="ThumbnailSize"
                            Style="{StaticResource ThumbnailSizeSelectorLastStyle}"
                            Tag="Large"
                            ToolTip="Large">

                            <Path
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M 0,0 H 1 V 1 H 0 Z"
                                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type RadioButton}}}"
                                Stretch="Fill" />

                        </RadioButton>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <Border Grid.Row="2" Background="{StaticResource ContentBackgroundBrush}">

            <Grid>

                <ListBox
                    x:Name="FileList"
                    Padding="9"
                    HorizontalContentAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource MocListBoxItemStyle}"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">

                    <ListBox.ItemsPanel>

                        <ItemsPanelTemplate>

                            <local:VirtualizingWrapPanel />

                        </ItemsPanelTemplate>

                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>

                        <DataTemplate>

                            <StackPanel
                                Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                Height="{Binding CardHeight, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                Margin="0">

                                <Border
                                    x:Name="ThumbnailBorder"
                                    Width="{Binding ThumbnailWidth, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    Height="{Binding ThumbnailHeight, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                    Background="{StaticResource ThumbnailBackgroundBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="Thumbnail_MouseLeftButtonUp"
                                    SnapsToDevicePixels="True">

                                    <Grid ClipToBounds="True">

                                        <Image
                                            Margin="5"
                                            Source="{Binding Thumbnail}"
                                            Stretch="Uniform">

                                            <Image.Style>

                                                <Style TargetType="Image">

                                                    <Setter Property="Visibility" Value="Collapsed" />

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding IsThumbnailLoaded}" Value="True">

                                                            <Setter Property="Visibility" Value="Visible" />

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </Image.Style>

                                        </Image>

                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            Text="Loading...">

                                            <TextBlock.Style>

                                                <Style TargetType="TextBlock">

                                                    <Setter Property="Visibility" Value="Collapsed" />

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding IsThumbnailLoading}" Value="True">

                                                            <Setter Property="Visibility" Value="Visible" />

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </TextBlock.Style>

                                        </TextBlock>

                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            Text="Not loaded">

                                            <TextBlock.Style>

                                                <Style TargetType="TextBlock">

                                                    <Setter Property="Visibility" Value="Collapsed" />

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding IsThumbnailNotLoaded}" Value="True">

                                                            <Setter Property="Visibility" Value="Visible" />

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </TextBlock.Style>

                                        </TextBlock>

                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{StaticResource SecondaryTextBrush}"
                                            Text="No thumbnail">

                                            <TextBlock.Style>

                                                <Style TargetType="TextBlock">

                                                    <Setter Property="Visibility" Value="Collapsed" />

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding IsThumbnailMissing}" Value="True">

                                                            <Setter Property="Visibility" Value="Visible" />

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </TextBlock.Style>

                                        </TextBlock>

                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontWeight="Bold"
                                            Foreground="{StaticResource ErrorTextBrush}"
                                            Text="⚠ Invalid file">

                                            <TextBlock.Style>

                                                <Style TargetType="TextBlock">

                                                    <Setter Property="Visibility" Value="Collapsed" />

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding IsThumbnailError}" Value="True">

                                                            <Setter Property="Visibility" Value="Visible" />

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </TextBlock.Style>

                                        </TextBlock>

                                        <Border
                                            Background="{StaticResource ThumbnailOverlayBrush}"
                                            CornerRadius="6"
                                            IsHitTestVisible="False">

                                            <Border.Style>

                                                <Style TargetType="Border">

                                                    <Setter Property="Visibility" Value="Collapsed" />

                                                    <Setter Property="Opacity" Value="0" />

                                                    <Style.Triggers>

                                                        <MultiDataTrigger>

                                                            <MultiDataTrigger.Conditions>

                                                                <Condition Binding="{Binding IsThumbnailLoaded}" Value="True" />

                                                                <Condition Binding="{Binding IsMouseOver, ElementName=ThumbnailBorder}" Value="True" />

                                                            </MultiDataTrigger.Conditions>

                                                            <Setter Property="Visibility" Value="Visible" />

                                                            <Setter Property="Opacity" Value="1" />

                                                        </MultiDataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </Border.Style>

                                            <Grid>

                                                <Border
                                                    Width="114"
                                                    Height="38"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="#3D3F45"
                                                    BorderBrush="#77777A"
                                                    BorderThickness="1"
                                                    CornerRadius="4">

                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="14"
                                                        FontWeight="SemiBold"
                                                        Foreground="#FFFFFF"
                                                        Text="Open file" />

                                                </Border>

                                            </Grid>

                                        </Border>

                                    </Grid>

                                </Border>

                                <TextBlock
                                    Margin="2,8,2,0"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryTextBrush}"
                                    Text="{Binding FileName, StringFormat={}{0}.io}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding FilePath}" />

                                <TextBlock
                                    Margin="2,3,2,0"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource SecondaryTextBrush}"
                                    Text="{Binding Metadata.PartCount, StringFormat={}{0} parts}" />

                                <TextBlock
                                    Margin="2,3,2,0"
                                    FontSize="11"
                                    Foreground="{StaticResource ErrorTextBrush}"
                                    Text="{Binding ErrorMessage}"
                                    TextWrapping="Wrap" />

                            </StackPanel>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

                <TextBlock
                    x:Name="NoResultsText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    IsHitTestVisible="False"
                    Text="No models found"
                    Visibility="Collapsed" />

                <TextBlock
                    x:Name="NoFolderSelectedText"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{StaticResource SecondaryTextBrush}"
                    IsHitTestVisible="False"
                    Text="No folder selected"
                    Visibility="Visible" />

            </Grid>

        </Border>

    </Grid>

</Window>